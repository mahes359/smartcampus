# Central Database Infrastructure (PostgreSQL - Database per service pattern)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Service Discovery & Gateway
EUREKA_URL=http://localhost:8761/eureka/
GATEWAY_PORT=8080

# Service Ports & Database Endpoints
AUTH_PORT=8090
AUTH_DB_URL=jdbc:postgresql://localhost:5432/college_auth

