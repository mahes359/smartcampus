# =====================================================
# SmartCampus Docker Deployment Environment Variables
# =====================================================

# PostgreSQL Application Database Credentials
POSTGRES_USER=collegeuser
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=college_auth

# Database Host & Port (Used inside Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=collegeuser

# Service Discovery (Eureka)
EUREKA_URL=http://eureka-server:8761/eureka/

# Security & JWT
JWT_SECRET=super_secret_smartcampus_jwt_signing_key_at_least_256_bits_long

# Frontend Build Time (empty for relative /api reverse proxy in production)
VITE_API_BASE_URL=
